--[[
    BRIDGE BATTLES — SMART BOT v4
    Logika: PICKUP → CARRY → PLACE → kembali ke PICKUP
    - Cari blok fisik warna tim (Anchored=false = belum ditaruh = bisa diambil)
    - Jalan ke ujung bridge (blok tim paling jauh dari spawn yang Anchored=true)
    - Place di ujung, balik ambil lagi
    Target: Bridge Battles (Roblox) — CloudEmulator friendly
]]

-- ── Cleanup ───────────────────────────────────────────────────────────────────
if _G.BBGui   then pcall(function() _G.BBGui:Destroy() end) end
if _G.BBConns then for _, c in ipairs(_G.BBConns) do pcall(function() c:Disconnect() end) end end
_G.BBConns = {}

-- ── Services ──────────────────────────────────────────────────────────────────
local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace  = game:GetService("Workspace")
local Camera     = Workspace.CurrentCamera

local LP = Players.LocalPlayer

-- ── Config ────────────────────────────────────────────────────────────────────
local Cfg = {
    AutoPlay   = false,
    WalkSpeed  = 20,
    PlaceRate  = 0.2,   -- jeda antar place (detik)
    ReachDist  = 3.5,   -- jarak dianggap "nyampe" tujuan
    ScanRadius = 200,   -- radius scan workspace
}

-- ── State ─────────────────────────────────────────────────────────────────────
-- Phase:
--   "PICKUP"   = tangan kosong, cari & jalan ke blok tim
--   "CARRY"    = bawa blok, jalan ke ujung bridge
--   "PLACE"    = di ujung, naruh blok, lalu balik ke PICKUP
local Phase       = "PICKUP"
local SpawnPos    = nil   -- posisi spawn disimpan sekali
local BridgeDir   = nil   -- arah bridge (Vector3 unit)
local BridgeEnd   = nil   -- posisi ujung bridge (Vector3)
local MoveTarget  = nil   -- target MoveTo saat ini
local lastPlace   = 0

-- ── Helpers ───────────────────────────────────────────────────────────────────
local function getChar()
    local c = LP.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChild("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function hasTool()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Tool") ~= nil
end

local function getTeamColor()
    -- Tunggu sampai team benar-benar ada
    if LP.Team and LP.TeamColor then
        return LP.TeamColor.Color
    end
    return nil
end

-- Pindah ke target, return true kalau udah nyampe
local function moveTo(hum, hrp, target)
    local flat = Vector3.new(target.X, hrp.Position.Y, target.Z)
    if (hrp.Position - flat).Magnitude <= Cfg.ReachDist then
        MoveTarget = nil
        return true
    end
    if MoveTarget == nil or (MoveTarget - flat).Magnitude > 1.5 then
        MoveTarget = flat
        hum:MoveTo(flat)
    end
    return false
end

-- Deteksi arah bridge dari blok tim yang sudah terpasang (Anchored=true)
-- Arah = rata-rata vektor dari SpawnPos ke tiap blok terpasang
local function detectBridgeDir(hrp)
    local tc = getTeamColor()
    if not tc or not SpawnPos then return end

    local sum   = Vector3.new(0, 0, 0)
    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Anchored and obj.Color == tc then
            local fromSpawn = obj.Position - SpawnPos
            local flat      = Vector3.new(fromSpawn.X, 0, fromSpawn.Z)
            if flat.Magnitude > 2 and flat.Magnitude < Cfg.ScanRadius then
                sum   = sum + flat.Unit
                count = count + 1
            end
        end
    end

    if count > 0 then
        BridgeDir = (sum / count).Unit
        print("[BB] BridgeDir detected: " .. tostring(BridgeDir))
    else
        -- Fallback: arah look karakter saat spawn
        BridgeDir = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z).Unit
        print("[BB] BridgeDir fallback (LookVector): " .. tostring(BridgeDir))
    end
end

-- Cari blok tim yang bisa diambil (Anchored=false, warna tim, deket spawn)
local function findPickableBlock(hrp)
    local tc = getTeamColor()
    if not tc then return nil end

    local best, bestDist = nil, 80
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart")
            and not obj.Anchored          -- belum ditaruh = bisa diambil
            and obj.Color == tc
            and obj.Parent               -- masih exist
        then
            -- Pastikan ini blok dekat area spawn (bukan blok yg lagi dibawa player lain)
            local d = (obj.Position - hrp.Position).Magnitude
            if d < bestDist then
                bestDist = d
                best     = obj
            end
        end
    end
    return best
end

-- Cari ujung bridge tim = blok anchored tim yang paling jauh dari spawn di arah BridgeDir
local function findBridgeEnd(hrp)
    local tc  = getTeamColor()
    local dir = BridgeDir
    if not tc or not dir or not SpawnPos then return nil end

    local best, bestProj = nil, -math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Anchored and obj.Color == tc then
            -- Proyeksi posisi obj ke arah bridge dari spawn
            local fromSpawn = obj.Position - SpawnPos
            local proj      = Vector3.new(fromSpawn.X, 0, fromSpawn.Z):Dot(dir)
            if proj > bestProj and proj > 0 then
                bestProj = proj
                best     = obj
            end
        end
    end

    if best then
        -- Target = satu blok lebih jauh dari ujung (tempat place berikutnya)
        return best.Position + dir * best.Size.Z  -- offset 1 blok ke depan
    end
    return nil
end

-- Place blok: VirtualUser click ke posisi ujung bridge di screen
local function doPlace(hrp)
    local now = tick()
    if now - lastPlace < Cfg.PlaceRate then return end

    local dir = BridgeDir or hrp.CFrame.LookVector
    -- Target place: 4 stud ke depan, setinggi lantai bridge
    local placePos  = hrp.Position + dir * 4 + Vector3.new(0, -2, 0)
    local screenPos, onScreen = Camera:WorldToScreenPoint(placePos)

    if onScreen then
        pcall(function()
            game:GetService("VirtualUser"):Button1Down(
                Vector2.new(screenPos.X, screenPos.Y), CFrame.new())
        end)
        task.delay(0.06, function()
            pcall(function()
                game:GetService("VirtualUser"):Button1Up(
                    Vector2.new(screenPos.X, screenPos.Y), CFrame.new())
            end)
        end)
    else
        -- Fallback tool:Activate
        local c = LP.Character
        local t = c and c:FindFirstChildOfClass("Tool")
        if t then pcall(function() t:Activate() end) end
    end

    lastPlace = now
end

-- ── Main Loop ─────────────────────────────────────────────────────────────────
local conn = RunService.Heartbeat:Connect(function()
    if not Cfg.AutoPlay then return end

    local char, hum, hrp = getChar()
    if not (char and hum and hrp) then return end

    -- Set WalkSpeed
    if hum.WalkSpeed ~= Cfg.WalkSpeed then hum.WalkSpeed = Cfg.WalkSpeed end

    -- Simpan spawn position sekali
    if not SpawnPos then
        SpawnPos = hrp.Position
        print("[BB] SpawnPos saved: " .. tostring(SpawnPos))
    end

    -- Deteksi arah bridge sekali (atau kalau belum ada)
    if not BridgeDir then
        detectBridgeDir(hrp)
    end

    -- ── State Machine ──────────────────────────────────────────────────────
    local carrying = hasTool()

    if Phase == "PICKUP" then
        if carrying then
            -- Tiba-tiba ngedapat tool (misal, nyentuh blok duluan)
            Phase = "CARRY"
            BridgeEnd = nil -- reset biar dicari ulang
            return
        end
        -- Cari blok terdekat warna tim
        local block = findPickableBlock(hrp)
        if block and block.Parent then
            moveTo(hum, hrp, block.Position)
        else
            -- Blok ngga ketemu — balik ke spawn dan tunggu respawn blok
            moveTo(hum, hrp, SpawnPos)
        end

    elseif Phase == "CARRY" then
        if not carrying then
            -- Tool hilang (keburu diambil / dibuang) → balik PICKUP
            Phase = "PICKUP"
            return
        end
        -- Cari ujung bridge
        if not BridgeEnd then
            BridgeEnd = findBridgeEnd(hrp)
        end
        local target = BridgeEnd or (SpawnPos + (BridgeDir or Vector3.new(0,0,0)) * 30)
        local arrived = moveTo(hum, hrp, target)
        if arrived then
            Phase = "PLACE"
        end

    elseif Phase == "PLACE" then
        if not carrying then
            -- Blok udah kepake
            Phase = "PICKUP"
            BridgeEnd = nil
            return
        end
        doPlace(hrp)
        -- Setelah place, tool akan hilang dari tangan — loop ini akan detect dan ganti phase
    end
end)

_G.BBConns[#_G.BBConns + 1] = conn

-- Kalau tool muncul di tangan → otomatis ganti ke CARRY
local toolConn = LP.CharacterAdded:Connect(function(char)
    SpawnPos  = nil
    BridgeDir = nil
    BridgeEnd = nil
    Phase     = "PICKUP"
    MoveTarget = nil
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and Cfg.AutoPlay then
            Phase     = "CARRY"
            BridgeEnd = nil
        end
    end)
    char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") and Cfg.AutoPlay then
            if Phase == "PLACE" or Phase == "CARRY" then
                Phase     = "PICKUP"
                BridgeEnd = nil
            end
        end
    end)
end)
_G.BBConns[#_G.BBConns + 1] = toolConn

-- Hook karakter yang sudah ada sekarang
local char = LP.Character
if char then
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and Cfg.AutoPlay then
            Phase = "CARRY"; BridgeEnd = nil
        end
    end)
    char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") and Cfg.AutoPlay then
            if Phase == "CARRY" or Phase == "PLACE" then
                Phase = "PICKUP"; BridgeEnd = nil
            end
        end
    end)
end

