-- Toggle factory
local function createToggle(parent, labelText, configKey, yPos)
    local Btn = Instance.new("TextButton", parent)
    Btn.Size             = UDim2.new(0.88, 0, 0, 38)
    Btn.Position         = UDim2.new(0.06, 0, 0, yPos)
    Btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    Btn.TextColor3       = Color3.fromRGB(220, 220, 220)
    Btn.Font             = Enum.Font.GothamBold
    Btn.TextSize         = 13
    Btn.Text             = labelText .. "  ●  OFF"
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

    Btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        local on = Config[configKey]
        Btn.Text             = labelText .. "  ●  " .. (on and "ON" or "OFF")
        Btn.BackgroundColor3 = on and Color3.fromRGB(20, 140, 60) or Color3.fromRGB(40, 40, 40)
    end)
    return Btn
end

