        Btn.BackgroundColor3 = on and Color3.fromRGB(20, 135, 55) or Color3.fromRGB(38, 38, 38)
        -- Reset bridge dir tiap kali AutoPlay diaktifkan
        if key == "AutoPlay" and on then St.bridgeDir = nil end
    end)
