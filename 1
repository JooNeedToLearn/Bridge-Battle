    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 5)
    Btn.MouseButton1Click:Connect(function()
        Config.WalkSpeed = math.clamp(Config.WalkSpeed + delta, 8, 40)
        SpeedLabel.Text  = "Speed: " .. Config.WalkSpeed
    end)
end
