local Players    = game:GetService("Players")
local Workspace  = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- ── Config ───────────────────────────────────────────────────────────────────
local Config = {
    AutoPlay    = false,   -- Take → Path → Place
    AutoShoot   = false,   -- Spam-activate equipped tool
    WalkSpeed   = 20,      -- Jaga di bawah 22 (aman)
    PlaceRate   = 0.18,    -- Detik antar place (lebih kecil = lebih cepet build)
    ShootRate   = 0.25,    -- Detik antar shoot
    ReachDist   = 4,       -- Jarak anggap "udah nyampe" tujuan (studs)
    SearchDepth = 6,       -- Kedalaman rekursi workspace scan
}

-- ── State ─────────────────────────────────────────────────────────────────────
local State = {
    lastPlace = 0,
    lastShoot = 0,
    moveTarget = nil,   -- Vector3 tujuan MoveTo saat ini
}

-- ── Helpers ───────────────────────────────────────────────────────────────────
local function getChar()
    local c = LocalPlayer.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChild("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function getTool()
    local c = LocalPlayer.Character
    return c and c:FindFirstChildOfClass("Tool")
end

-- Deep scan workspace dengan batasan kedalaman — cegah stack overflow
local function scanDescendants(root, depth, results)
    if depth <= 0 then return end
    for _, obj in ipairs(root:GetChildren()) do
        if obj:IsA("BasePart") then
            results[#results + 1] = obj
        end
        -- Masuk ke Model/Folder, tapi skip character player lain
        if (obj:IsA("Model") or obj:IsA("Folder")) and not Players:GetPlayerFromCharacter(obj) then
            scanDescendants(obj, depth - 1, results)
        end
    end
end

-- Cari blok tim terdekat (warna ATAU nama tim)
local function getNearestTeamBlock()
    local _, _, hrp = getChar()
    if not hrp or not LocalPlayer.Team then return nil end

    local teamColor = LocalPlayer.TeamColor.Color
    local teamName  = string.lower(LocalPlayer.Team.Name)

    local parts = {}
    scanDescendants(Workspace, Config.SearchDepth, parts)

    local nearest, shortest = nil, 120
    for _, obj in ipairs(parts) do
        local nameLow = string.lower(obj.Name)
        local isTeamColored = (obj.Color == teamColor)
        local isTeamNamed   = string.find(nameLow, teamName, 1, true)
        local isBlockPart   = string.find(nameLow, "block", 1, true)
                           or string.find(nameLow, "stud",  1, true)
                           or string.find(nameLow, "brick", 1, true)

        if (isTeamColored or isTeamNamed) and isBlockPart then
            local dist = (obj.Position - hrp.Position).Magnitude
            if dist < shortest then
                shortest = dist
                nearest  = obj
            end
        end
    end
    return nearest
end

-- Safe MoveTo: hanya kirim perintah baru kalau target berubah / belum nyampe
local function moveTo(hum, hrp, target)
    if not (hum and hrp and target) then return end
    local dist = (hrp.Position - target).Magnitude
    if dist <= Config.ReachDist then
        State.moveTarget = nil
        return true -- udah nyampe
    end
    -- Kirim MoveTo baru hanya kalau target beda dari yg terakhir
    if State.moveTarget == nil or (State.moveTarget - target).Magnitude > 1 then
        State.moveTarget = target
        hum:MoveTo(target)
    end
    return false
end

-- Place throttled
local function doPlace()
    local now = tick()
    if now - State.lastPlace < Config.PlaceRate then return end
    local tool = getTool()
    if tool then
        pcall(function() tool:Activate() end)
        State.lastPlace = now
    end
end

-- Shoot throttled
local function doShoot()
    local now = tick()
    if now - State.lastShoot < Config.ShootRate then return end
    local tool = getTool()
    if tool then
        pcall(function() tool:Activate() end)
        State.lastShoot = now
    end
end

-- ── Loop Utama (Heartbeat-safe: TANPA task.wait di dalam) ─────────────────────
local conn = RunService.Heartbeat:Connect(function()
    local char, hum, hrp = getChar()
    if not (char and hum and hrp) then return end

    -- Jaga WalkSpeed
    if hum.WalkSpeed ~= Config.WalkSpeed then
        hum.WalkSpeed = Config.WalkSpeed
    end

    -- AUTO SHOOT
    if Config.AutoShoot then
        doShoot()
    end

    -- AUTO PLAY
    if Config.AutoPlay then
        local tool = getTool()

        if tool then
            -- Punya blok → jalan lurus ke depan sambil place
            local forwardTarget = hrp.Position + hrp.CFrame.LookVector * 12
            -- Matikan Y drift biar ngga jatuh kalau ada slope kecil
            forwardTarget = Vector3.new(forwardTarget.X, hrp.Position.Y, forwardTarget.Z)
            moveTo(hum, hrp, forwardTarget)
            doPlace()
        else
            -- Tangan kosong → cari blok tim
            local block = getNearestTeamBlock()
            if block then
                local arrived = moveTo(hum, hrp, block.Position)
                -- Kalau udah sampai tapi blok masih ada, tap buat ambil
                if arrived then
                    pcall(function()
                        -- Simulasi touch/interact — beberapa game pake ProximityPrompt
                        local pp = block:FindFirstChildOfClass("ProximityPrompt")
                        if pp then
                            fireproximityprompt(pp)  -- executor global func
                        end
                    end)
                end
            else
                -- Blok ngga ketemu → wander pelan ke titik random deket spawn
                local wander = hrp.Position + Vector3.new(
                    math.random(-8, 8), 0, math.random(-8, 8)
                )
                moveTo(hum, hrp, wander)
            end
        end
    end
end)

_G.BridgeBotConnections[#_G.BridgeBotConnections + 1] = conn

