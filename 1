-- ── Char helpers ──────────────────────────────────────────────────────────────
local function getChar()
    local c = LP.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChild("Humanoid"), c:FindFirstChild("HumanoidRootPart")
end

local function getTool()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Tool")
end

-- ── Hitung arah bridge sekali saat spawn ─────────────────────────────────────
-- Bridge Battles: dua tim spawn di ujung berlawanan sumbu Z (atau X).
-- Kita deteksi dengan cari spawn point tim lawan = arah yg harus dituju.
local function detectBridgeDir(hrp)
    -- Coba cari SpawnLocation lawan
    local myTeam = LP.Team
    local bestDir = nil
    local bestDist = 0

    for _, spawn in ipairs(Workspace:GetDescendants()) do
        if spawn:IsA("SpawnLocation") and spawn.TeamColor ~= LP.TeamColor then
            local dir = (spawn.Position - hrp.Position)
            if dir.Magnitude > bestDist then
                bestDist = dir.Magnitude
                bestDir  = dir.Unit
            end
        end
    end

    -- Fallback: kalau ngga ketemu, cek bridge model — ambil ujung terjauh
    if not bestDir then
        local farthest = hrp.Position
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (
                string.find(string.lower(obj.Name), "bridge", 1, true) or
                string.find(string.lower(obj.Name), "plank", 1, true) or
                string.find(string.lower(obj.Name), "tile",  1, true)
            ) then
                if (obj.Position - hrp.Position).Magnitude > (farthest - hrp.Position).Magnitude then
                    farthest = obj.Position
                end
            end
        end
        if (farthest - hrp.Position).Magnitude > 10 then
            local d = (farthest - hrp.Position)
            bestDir = Vector3.new(d.X, 0, d.Z).Unit
        end
    end

    -- Fallback akhir: lihat arah kamera saat spawn
    if not bestDir then
        bestDir = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z).Unit
    end

    St.bridgeDir = bestDir
    print("[BridgeBot] Bridge direction detected: " .. tostring(bestDir))
end

-- ── Baca jumlah blok dari GUI game (leaderstats / GUI label) ─────────────────
local function getBlockCount()
    -- Coba dari leaderstats
    local ls = LP:FindFirstChild("leaderstats")
    if ls then
        local b = ls:FindFirstChild("Blocks") or ls:FindFirstChild("Block")
        if b then return tonumber(b.Value) or 999 end
    end
    -- Coba dari PlayerGui label
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        for _, d in ipairs(pg:GetDescendants()) do
            if d:IsA("TextLabel") and string.find(d.Text, "Block", 1, true) then
                local n = tonumber(d.Text:match("%d+"))
                if n then return n end
            end
        end
    end
    return 999 -- anggap cukup kalau ngga bisa dibaca
end

-- ── Auto-buy blok (klik tombol +100 di GUI game) ─────────────────────────────
local function autoBuy()
    local now = tick()
    if now - St.lastBuy < Cfg.BuyRate then return end
    if getBlockCount() >= Cfg.MinBlocks then return end

    -- Cari tombol beli di PlayerGui (biasanya TextButton "+100" atau sejenisnya)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end

    local bestBtn = nil
    local bestVal = 0
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextButton") and d.Visible then
            -- Cari tombol yang mengandung "+" dan angka
            local val = tonumber(d.Text:match("%+?(%d+)"))
            if val and val > bestVal and val <= 100 then
                bestVal = val
                bestBtn = d
            end
        end
    end

    if bestBtn then
        -- Simulasi klik tombol UI
        pcall(function()
            local mpos = bestBtn.AbsolutePosition + bestBtn.AbsoluteSize / 2
            VirtualUser:ClickButton2d(mpos)
        end)
        -- Fallback: fire MouseButton1Click
        pcall(function() bestBtn:activate() end)
        St.lastBuy = now
    end
end

-- ── Place block: VirtualUser click ke titik di depan karakter ────────────────
-- Ini jauh lebih reliable dari tool:Activate() karena ada target posisi nyata.
local function doPlace(hrp)
    local now = tick()
    if now - St.lastPlace < Cfg.PlaceRate then return end

    local dir = St.bridgeDir or (hrp and hrp.CFrame.LookVector) or Vector3.new(0,0,-1)
    dir = Vector3.new(dir.X, 0, dir.Z).Unit

    -- Target di depan karakter, sedikit ke bawah (level lantai bridge)
    local target3D = hrp.Position + dir * Cfg.PlaceOffset + Vector3.new(0, -2.5, 0)

    -- Project ke screen position
    local screenPos, onScreen = Camera:WorldToScreenPoint(target3D)

    if onScreen then
        pcall(function()
            VirtualUser:Button1Down(Vector2.new(screenPos.X, screenPos.Y), CFrame.new())
            task.delay(0.05, function()
                VirtualUser:Button1Up(Vector2.new(screenPos.X, screenPos.Y), CFrame.new())
            end)
        end)
    else
        -- Fallback kalau off-screen
        pcall(function()
            local tool = getTool()
            if tool then tool:Activate() end
        end)
    end

    St.lastPlace = now
end

-- ── Auto-shoot: sama pakai VirtualUser ───────────────────────────────────────
local function doShoot(hrp)
    local now = tick()
    if now - St.lastShoot < Cfg.ShootRate then return end

    -- Tembak ke arah musuh terdekat
    local nearest, nearDist = nil, 60
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Team ~= LP.Team then
            local pc = p.Character
            local phrp = pc and pc:FindFirstChild("HumanoidRootPart")
            if phrp then
                local d = (phrp.Position - hrp.Position).Magnitude
                if d < nearDist then nearDist = d; nearest = phrp end
            end
        end
    end

    local targetPos = nearest and nearest.Position or (hrp.Position + hrp.CFrame.LookVector * 20)
    local screenPos, onScreen = Camera:WorldToScreenPoint(targetPos)

    if onScreen then
        pcall(function()
            VirtualUser:Button1Down(Vector2.new(screenPos.X, screenPos.Y), CFrame.new())
            task.delay(0.05, function()
                VirtualUser:Button1Up(Vector2.new(screenPos.X, screenPos.Y), CFrame.new())
            end)
        end)
    else
        pcall(function()
            local tool = getTool()
            if tool then tool:Activate() end
        end)
    end

    St.lastShoot = now
end

-- ── Safe MoveTo dengan goal check ────────────────────────────────────────────
local function moveTo(hum, hrp, target)
    if not (hum and hrp and target) then return false end
    local flat = Vector3.new(target.X, hrp.Position.Y, target.Z)
    if (hrp.Position - flat).Magnitude <= Cfg.ReachDist then
        St.moveTarget = nil
        return true
    end
    if St.moveTarget == nil or (St.moveTarget - flat).Magnitude > 1.5 then
        St.moveTarget = flat
        hum:MoveTo(flat)
    end
    return false
end

-- ── Loop Utama ────────────────────────────────────────────────────────────────
local conn = RunService.Heartbeat:Connect(function()
    local char, hum, hrp = getChar()
    if not (char and hum and hrp) then return end

    -- WalkSpeed
    if hum.WalkSpeed ~= Cfg.WalkSpeed then hum.WalkSpeed = Cfg.WalkSpeed end

    -- Deteksi arah bridge sekali
    if not St.bridgeDir then
        detectBridgeDir(hrp)
    end

    -- Auto-buy
    if Cfg.AutoBuy and Cfg.AutoPlay then
        autoBuy()
    end

    -- Auto Shoot
    if Cfg.AutoShoot then
        doShoot(hrp)
    end

    -- Auto Play: jalan ke ujung bridge sambil place
    if Cfg.AutoPlay then
        local dir = St.bridgeDir or Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z).Unit
        -- Target: terus maju 20 stud ke arah bridge
        local target = hrp.Position + dir * 20
        target = Vector3.new(target.X, hrp.Position.Y, target.Z)
        moveTo(hum, hrp, target)
        doPlace(hrp)
    end
end)

_G.BridgeBotConnections[#_G.BridgeBotConnections + 1] = conn

